     renderer: structlog.typing.Processor = (
-        structlog.dev.ConsoleRenderer(colors=sys.stderr.isatty())
+        structlog.dev.ConsoleRenderer(colors=colors and sys.stderr.isatty())
         if fmt == "console"
         else structlog.processors.JSONRenderer()
     )
