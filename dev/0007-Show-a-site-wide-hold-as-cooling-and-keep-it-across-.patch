 src/vinted_sniper/app.py                       | 12 ++++++++++++
 src/vinted_sniper/botctl/telegram_bot.py       |  2 ++
 src/vinted_sniper/engine/health.py             | 13 +++++++++++++
 src/vinted_sniper/engine/poller.py             |  5 +++++
