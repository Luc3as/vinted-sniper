+<script>
+(() => {
+  "use strict";
+  // Edit rows.
+  for (const button of document.querySelectorAll("[data-edit]")) {
+    button.addEventListener("click", () => {
+      const row = document.getElementById(`edit-${button.dataset.edit}`);
+      if (!row) return;
+      row.hidden = !row.hidden;
+      for (const b of document.querySelectorAll(`[data-edit="${button.dataset.edit}"]`)) {
+        b.setAttribute("aria-expanded", String(!row.hidden));
+      }
+      if (!row.hidden) row.querySelector("input")?.focus();
+    });
+  }
+
+  // Live status: the table redraws itself from /api/health, and the relative times tick.
+  const table = document.getElementById("searches");
+  if (!table) return;
+  const header = document.querySelector("header .status");
+
+  function ago(ts, now) {
+    if (!ts) return null;
+    const s = Math.max(0, now - ts);
+    if (s < 90) return `${s}s ago`;
+    if (s < 5400) return `${Math.round(s / 60)}m ago`;
+    if (s < 172800) return `${Math.round(s / 3600)}h ago`;
+    return `${Math.round(s / 86400)}d ago`;
+  }
+
+  function tick() {
+    const now = Math.floor(Date.now() / 1000);
+    for (const cell of table.querySelectorAll("[data-ts]")) {
+      const ts = Number(cell.dataset.ts);
+      if (!ts) continue;
+      if (cell.dataset.field === "next") {
+        cell.textContent = ts > now ? `in ${ts - now}s` : "due";
+      } else {
+        cell.textContent = ago(ts, now);
+      }
+    }
+  }
+
+  async function refresh() {
+    let data;
+    try {
+      const res = await fetch("/api/health", { headers: { Accept: "application/json" } });
+      if (!res.ok) return;
+      data = await res.json();
+    } catch { return; }
+    if (header) {
+      header.textContent = `${data.alive ? "running" : "not responding"} · ${data.queued_notifications} queued`;
+    }
+    for (const search of data.searches) {
+      const row = table.querySelector(`tr[data-query-id="${search.query_id}"]`);
+      if (!row) continue;  // added since the page loaded; a reload will show it
+      const state = row.querySelector('[data-field="state"]');
+      if (state && state.textContent !== search.state) {
+        state.textContent = search.state;
+        state.className = `pill ${search.state}`;
+      }
+      row.querySelector('[data-field="found"]').textContent = search.items_total;
+      row.querySelector('[data-field="last"]').dataset.ts = search.last_success_at || "";
+      row.querySelector('[data-field="next"]').dataset.ts = search.next_check_at || "";
+      row.querySelector('[data-field="newest"]').dataset.ts = search.newest_listing_at || "";
+      const err = row.querySelector('[data-field="error"]');
+      err.hidden = !search.last_error;
+      err.textContent = (search.last_error || "").slice(0, 110);
+    }
+    tick();
+  }
+
+  setInterval(tick, 1000);
+  setInterval(refresh, 10000);
+})();
